# Copy to .env (git-ignored) for LOCAL development. Never commit .env.
# In production set these as real environment variables on the host instead (see README "Deployment").

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Local development: True. Production: False (the default when unset).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only (all optional locally) ---
# PostgreSQL connection string; without it the app uses SQLite (db.sqlite3).
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_BEHIND_TLS_PROXY=True      # only behind a proxy that sets X-Forwarded-Proto itself
# DJANGO_HSTS_SECONDS=86400         # raise (e.g. 31536000) once HTTPS is verified
# DJANGO_SECURE_SSL_REDIRECT, DJANGO_SESSION_COOKIE_SECURE, DJANGO_CSRF_COOKIE_SECURE, DJANGO_HSTS_INCLUDE_SUBDOMAINS,
# DJANGO_HSTS_PRELOAD, DJANGO_DB_CONN_MAX_AGE, DJANGO_LOG_LEVEL: see README for defaults

# --- First application admin (optional; used by `manage.py create_app_admin`, e.g. on Render's start command) ---
# DJANGO_APP_ADMIN_USERNAME=
# DJANGO_APP_ADMIN_EMAIL=
# DJANGO_APP_ADMIN_PASSWORD=   # one-time; the account must change it at first login. Remove once created.
